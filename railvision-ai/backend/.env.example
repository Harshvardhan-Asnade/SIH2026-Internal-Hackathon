# ── RailVision AI — Environment Variables ────────────────────────────
# Copy to .env and customise.  All values have sensible defaults in
# app/config.py, so this file is optional.

# Application
APP_NAME=RailVision AI
APP_VERSION=0.1.0
DEBUG=false

# Model
MODEL_NAME=yolo11n.pt
MODEL_CONFIDENCE=0.40
MODEL_IOU_THRESHOLD=0.45
# Options: cpu | cuda | mps (Apple Silicon)
MODEL_DEVICE=cpu

# Upload limits
MAX_UPLOAD_SIZE_MB=500

# Server
HOST=0.0.0.0
PORT=8000
